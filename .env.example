# ==========================================
# Docker Compose
# ==========================================
POSTGRES_DB=hospital
POSTGRES_PORT=5432
SERVER_PORT=8080

# ==========================================
# PostgreSQL
# ==========================================
DB_USERNAME=hospital
DB_PASSWORD=replace_with_a_secure_database_password

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# ==========================================
# JWT
# Generate with: openssl rand -base64 32
# ==========================================
JWT_SECRET=replace_with_a_secure_base64_secret
JWT_EXPIRATION_MS=900000
JWT_ISSUER=hospital-api

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# Login protection
# ==========================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_BLOCK_DURATION_MS=900000

# ==========================================
# Logging
# ==========================================
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO



# ==========================================
# Initial administrator
# Enable only for the first production start
# ==========================================
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
BOOTSTRAP_ADMIN_DOCUMENT_ID=ADMIN001
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
BOOTSTRAP_ADMIN_PHONE=